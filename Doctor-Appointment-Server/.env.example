# ── Server ──
PORT=5000
NODE_ENV=development

# ── Database (MongoDB) ──
# Local dev fallback: mongodb://localhost:27017/doctor-appointment
# For production: your MongoDB Atlas connection string
MONGODB_URI=

# ── JWT Secrets (change these in production!) ──
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Client ──
# Frontend URL for CORS. In dev: http://localhost:5173
# In prod: https://medibook.vercel.app (or your custom domain)
CLIENT_URL=http://localhost:5173

# ── Email (Resend / SendGrid / any SMTP) ──
# Leave empty to use console fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@medibook.com

# ── Google OAuth ──
GOOGLE_CLIENT_ID=

# ── reCAPTCHA ──
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET=

# ── Google Cloud Storage (for file uploads) ──
# Required for Cloud Run deployment (stateless)
GCS_BUCKET_NAME=
GCP_PROJECT_ID=
